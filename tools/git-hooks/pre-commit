#!/usr/bin/env bash
# tools/git-hooks/pre-commit
#
# Reject the commit if any first-party staged C/C++ file has formatting drift.
# Mirrors the CI clang-format check so contributors fail locally rather than
# in CI. Install with:  tools/git-hooks/install.sh

set -euo pipefail

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not on PATH; skipping format check." >&2
    exit 0
fi

# Staged files matching first-party C/C++ paths. Avoid `mapfile`/`readarray`
# — those are bash 4+ builtins; macOS ships with bash 3.2.
files=$(git diff --cached --name-only --diff-filter=ACMR \
    -- '*.cpp' '*.cxx' '*.cc' '*.c' '*.h' '*.hpp' '*.hxx' \
    | grep -E '^(src|tools|tests)/' \
    | grep -v '^third_party/' \
    || true)

[ -z "$files" ] && exit 0

bad=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    if ! clang-format --dry-run --Werror --style=file "$f" 2>/dev/null; then
        bad="${bad}${f}"$'\n'
    fi
done <<< "$files"

if [ -n "$bad" ]; then
    echo
    echo "pre-commit: the following files need clang-format:" >&2
    printf '  %s\n' $bad >&2
    echo
    echo "Fix with:  clang-format -i $(echo $bad | tr '\n' ' ')" >&2
    exit 1
fi

exit 0
